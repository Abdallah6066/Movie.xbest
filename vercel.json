{
  "version": 2,
  "name": "meme-trick",
  "builds": [
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "posts/*.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/posts/(.*)", "dest": "/posts/$1" },
    { "src": "/viewer", "dest": "/viewer.html" },
    { "src": "/", "dest": "/posts/01.html" }
  ],
  "headers": [
    {
      "source": "/posts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
